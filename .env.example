# Optional canonical public origin. Set this to the custom domain when one is connected.
# Render's RENDER_EXTERNAL_URL is used automatically when this is blank.
PUBLIC_SITE_URL=

# Used only to initialise an original single-club owner when no owner account exists.
# Existing accounts always authenticate against their current saved password; this is not a second login credential.
APP_PASSWORD=
LEGACY_ARCHIVE_EMAIL=archive@botgc.test
LEGACY_ARCHIVE_DISPLAY_NAME=BOTGC archive administrator
LEGACY_CLUB_NAME=Burton-on-Trent Golf Club
LEGACY_CLUB_SPORT=Golf
LEGACY_CLUB_COUNTRY=United Kingdom

# Required for automatic engraving reading and generated trophy illustrations.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

# Optional. Use {{trophy_name}} where the trophy name should be inserted.
# Leave empty to use the built-in straight-on, shelf-ready vector illustration prompt.
TROPHY_ILLUSTRATION_PROMPT=

# Wait after the most recent upload before analysing the whole image set (2-60 seconds).
ANALYSIS_DEBOUNCE_SECONDS=20

# Local default is ./data-store. Render sets this to its persistent disk.
# Account records, protected session keys, club logos, catalogues and images live here.
DATA_PATH=

# Transactional email. Signup stays unavailable until mail and PUBLIC_SITE_URL are configured.
# Production: smtp with TLS. Development-only alternative: development + absolute pickup directory.
EMAIL_TRANSPORT=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_DEVELOPMENT_DIRECTORY=

# Hosted checkout is disabled by default. Use test keys and signed test webhooks first.
BILLING_MODE=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_LIVE_APPROVED=false
BILLING_LEGAL_READY=false

# Leave unavailable until a supported, contracted integration is actually ready to deliver.
IG_INTEGRATION_AVAILABLE=false
STRIPE_IG_PRICE_ID=

# Archive growth limits. Existing records remain readable; no files are removed to meet a limit.
# Unlimited legacy trophy credits remain unlimited; shared disk safety limits still apply.
ARCHIVE_FREE_STORAGE_BYTES=268435456
ARCHIVE_PAID_STORAGE_BYTES=2147483648
ARCHIVE_SHARED_STORAGE_BYTES=4294967296
ARCHIVE_MIN_FREE_DISK_BYTES=134217728
ARCHIVE_MAX_UPLOAD_BYTES=12582912
ARCHIVE_MAX_ILLUSTRATION_BYTES=33554432
ARCHIVE_MAX_STATE_BYTES=16777216
ARCHIVE_DRAFT_TROPHIES=4
ARCHIVE_MAX_WINNERS_PER_TROPHY=4000
ARCHIVE_MAX_WINNERS=100000
